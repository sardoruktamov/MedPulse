### =================================================================
### 1-QADAM: OTA (USER) TIZIMGA KIRADI
### Maqsad: Token olish va keyingi so'rovlarda ishlatish
### =================================================================
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "998911576777",
  "password": "12345"
}

> {%
    client.global.set("userToken", response.body.accessToken);
    client.log("OTA TOKENI OLINDI: " + response.body.accessToken);
%}

###

### =================================================================
### 2-QADAM: DOKTOR TIZIMGA KIRADI
### Maqsad: Token olish va keyingi so'rovlarda ishlatish
### =================================================================
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "sardorbek.uktamov.1@mail.ru",
  "password": "12345"
}

> {%
    client.global.set("doctorToken", response.body.accessToken);
    client.log("DOKTOR TOKENI OLINDI: " + response.body.accessToken);
%}

###

### =================================================================
### 3-QADAM: OTA O'Z FARZANDI UCHUN KOD OLADI (GENERATE)
### Ssenariy: Ota ilovada "Shifokorga ko'rsatish" tugmasini bosdi.
### =================================================================
POST http://localhost:8080/api/v1/access/generate/7ffe334d-7c50-47a1-95f9-5d1965eabc76
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiI5OTg5MTE1NzY3NzciLCJyb2xlcyI6IlJPTEVfQURNSU4iLCJpZCI6IjEiLCJpYXQiOjE3NzA4MjcyNDQsImV4cCI6MTc3MDkxMzY0NH0.KjE7ZAElJis7Y5XtwQAu0ELUy9SEB9QLD8s8126S3nwVGT6L1HJW4BEiWMi6eswib2_Txvn4D8k-__5M-G1CcA

> {%
    // Server qaytargan 6 xonali kodni keyingi so'rov uchun saqlab olamiz
    client.global.set("accessCode", response.body);
    client.log("GENERATSIYA QILINGAN KOD: " + response.body);
%}

